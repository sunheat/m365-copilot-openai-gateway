# Microsoft Entra application registration (single-tenant public client)
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id

# Local listener. Keep loopback-only for development.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Optional local-client bearer key. Leave blank only for one-user loopback tests.
GATEWAY_API_KEY=

# Diagnostic logging. Levels: silent, error, warn, info, debug, trace.
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_FORMAT=pretty

# IANA timezone supplied to every Copilot chat turn.
M365_TIME_ZONE=Australia/Sydney

# Optional overrides for the encrypted MSAL cache and Microsoft Graph endpoint.
M365_TOKEN_CACHE_DIR=
GRAPH_BASE_URL=https://graph.microsoft.com/beta

# Streaming lifecycle limits. Values are milliseconds except the event-size limit.
GRAPH_STREAM_START_TIMEOUT_MS=30000
GRAPH_STREAM_IDLE_TIMEOUT_MS=60000
GRAPH_STREAM_MAX_EVENT_BYTES=2097152
GATEWAY_SSE_HEARTBEAT_MS=15000
